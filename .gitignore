# ============================================================
# FastVelix — monorepo root ignore rules
# ============================================================

# Dependencies (both apps)
/node_modules
/**/node_modules

# Build output
/**/.next
/**/out
/**/dist
/**/build
next-env.d.ts
*.tsbuildinfo

# Secrets — never commit real credentials
.env
.env.local
.env.*.local
!.env.example

# User uploads
/backend/uploads

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Tests / coverage
/coverage
